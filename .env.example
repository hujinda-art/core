OPENAI_API_KEY=sk-xxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 记忆策略（逗号分隔）
MEMORY_STRATEGIES=ShortMem,LongMem,CombinedMem

# 长期记忆后端：chromadb（默认）| hnsw
LONG_MEM_BACKEND=chromadb

# HNSW 嵌入方式（仅 LONG_MEM_BACKEND=hnsw 时生效）
# bge-m3 | bge-large-zh | sentence-transformers
HNSW_EMBEDDING=bge-m3
HNSW_EMBEDDING_DEVICE=cuda

# 防污染机制（true|false，默认 true）
LONG_MEM_ANTI_POLLUTION=true

# 评估模型（可独立配置，不设则回退到主 Agent 配置）
EVAL_OPENAI_BASE_URL=https://api.openai.com/v1
EVAL_OPENAI_API_KEY=sk-xxxxxx
EVAL_OPENAI_MODEL=gpt-4o-mini
EVAL_CONCURRENCY=5

# 短期记忆水位线（默认 0.5）
SHORT_MEM_SECOND_WATER_LEVEL=0.5

# 提示词文件配置（相对于 PROMPTS_DIR，默认 prompts/）
PROMPTS_DIR=prompts
AGENT_PROMPTS=agent.md
EVAL_BASIC_PROMPTS=evaluator_basic.md
EVAL_PROGRAMMING_PROMPTS=evaluator_programming.md

# 默认测试文件（逗号分隔）
TEST_FILES=quick_test.json